{
  "family": "cloudshield-dashboard",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::833453046706:role/cloudshield-dashboard-execution-role",
  "taskRoleArn": "arn:aws:iam::833453046706:role/cloudshield-dashboard-task-role",
  "containerDefinitions": [
    {
      "name": "cloudshield-dashboard",
      "image": "833453046706.dkr.ecr.ap-northeast-2.amazonaws.com/cloudshield-dashboard:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3000,
          "hostPort": 3000,


          
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "AWS_REGION",
          "value": "ap-northeast-2"
        },
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "GITHUB_OWNER",
          "value": "CloudShield-Lab"
        },
        {
          "name": "GITHUB_REPO",
          "value": "CloudShield_Lab"
        },
        {
          "name": "ANALYSIS_S3_BUCKET",
          "value": "sentinelshare-terraform-state-833453046706-ap-northeast-2-an"
        },
        {
          "name": "ANALYSIS_S3_PREFIX",
          "value": "analysis-sessions"
        },
        {
          "name": "BEDROCK_MODEL_ID",
          "value": "us.anthropic.claude-3-5-haiku-20241022-v1:0"
        },
        {
          "name": "BEDROCK_REGION",
          "value": "us-east-1"
        },
        {
          "name": "WAZUH_INSECURE",
          "value": "true"
        }
      ],
      "secrets": [
        {
          "name": "VULNERABLE_API_URL",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:833453046706:secret:cloudshield/dashboard/vulnerable-api-url-QsVekd"
        },
        {
          "name": "VULNERABLE_S3_BUCKET",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:833453046706:secret:cloudshield/dashboard/vulnerable-s3-bucket-iniFzC"
        },
        {
          "name": "AWS_API_URL",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:833453046706:secret:cloudshield/dashboard/aws-api-url-m2X4Os"
        },
        {
          "name": "AWS_S3_BUCKET",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:833453046706:secret:cloudshield/dashboard/aws-s3-bucket-W9Eizp"
        },
        {
          "name": "GITHUB_TOKEN",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:833453046706:secret:GITHUB_TOKEN-dCjhzq:GITHUB_TOKEN::"
        },
        {
          "name": "WAZUH_API_URL",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:833453046706:secret:cloudshield/dashboard/wazuh-UcRWR2:WAZUH_API_URL::"
        },
        {
          "name": "WAZUH_API_USER",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:833453046706:secret:cloudshield/dashboard/wazuh-UcRWR2:WAZUH_API_USER::"
        },
        {
          "name": "WAZUH_API_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:833453046706:secret:cloudshield/dashboard/wazuh-UcRWR2:WAZUH_API_PASSWORD::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/cloudshield-dashboard",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": ["CMD", "node", "-e", "require('http').get('http://127.0.0.1:3000/api/config',(r)=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"],
        "interval": 30,
        "timeout": 10,
        "retries": 5,
        "startPeriod": 120
      }
    }
  ]
}
