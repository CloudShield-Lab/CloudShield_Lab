# AWS 배포 후 실제 엔드포인트로 채워넣기.
# 로컬 개발 시: VULNERABLE_API_URL=http://localhost:3000 으로 설정하면 로컬 백엔드 대상으로 공격 가능.

# ─── 수동 구성: 취약 환경 ─────────────────────────────────────
# EC2 직접 노출 (Security Group 0.0.0.0/0, WAF 없음)
VULNERABLE_API_URL=http://your-vulnerable-ec2-ip:3000

# 취약 환경 프론트엔드 URL (브루트포스 성공 시 "접속하러 가보기" 링크용)
VULNERABLE_FRONTEND_URL=http://your-vulnerable-ec2-ip:3001

# S3: Block Public Access OFF, 버킷 정책 없음
VULNERABLE_S3_BUCKET=your-vulnerable-bucket-name

# ─── 수동 구성: 보안 환경 ─────────────────────────────────────
# CloudFront + WAF 앞단에 위치
AWS_API_URL=https://xxxxxxxxxxxx.cloudfront.net

# S3: Block Public Access ON, presigned URL만 허용
AWS_S3_BUCKET=your-secure-bucket-name

# ─── 자동 배포 (Terraform): 취약 환경 ────────────────────────
AUTO_VULNERABLE_API_URL=http://your-auto-vulnerable-ec2-ip:3000
AUTO_VULNERABLE_FRONTEND_URL=http://your-auto-vulnerable-ec2-ip:3001
AUTO_VULNERABLE_S3_BUCKET=your-auto-vulnerable-bucket-name

# ─── 자동 배포 (Terraform): 보안 환경 ────────────────────────
AUTO_AWS_API_URL=https://xxxxxxxxxxxx.cloudfront.net
AUTO_AWS_S3_BUCKET=your-auto-secure-bucket-name

# ─── 공통 ─────────────────────────────────────────────────────
AWS_REGION=ap-northeast-2
